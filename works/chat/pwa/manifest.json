{
  "name": "Team Chat - Secure Messaging App",
  "short_name": "Team Chat",
  "description": "Modern, secure team chat application with real-time messaging, voice & video calling, and offline support",
  "start_url": "/My-Personal-Website/works/chat/",
  "scope": "/My-Personal-Website/works/chat/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#6366F1",
  "background_color": "#FFFFFF",
  
  "icons": [
    {
      "src": "/My-Personal-Website/works/chat/assets/icons/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/icons/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/icons/app-icon-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/icons/app-icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  
  "categories": [
    "communication",
    "productivity"
  ],
  
  "screenshots": [
    {
      "src": "/My-Personal-Website/works/chat/assets/screenshots/mobile-1.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/screenshots/mobile-2.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/screenshots/desktop-2.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  
  "shortcuts": [
    {
      "name": "New Chat",
      "short_name": "New Chat",
      "description": "Start a new conversation",
      "url": "/My-Personal-Website/works/chat/?action=new-chat",
      "icons": [
        {
          "src": "/My-Personal-Website/works/chat/assets/icons/shortcut-new-chat.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Recent Chats",
      "short_name": "Chats",
      "description": "View recent conversations",
      "url": "/My-Personal-Website/works/chat/?action=chats",
      "icons": [
        {
          "src": "/My-Personal-Website/works/chat/assets/icons/shortcut-chats.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calls",
      "short_name": "Calls",
      "description": "View call history",
      "url": "/My-Personal-Website/works/chat/?action=calls",
      "icons": [
        {
          "src": "/My-Personal-Website/works/chat/assets/icons/shortcut-calls.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "share_target": {
    "action": "/My-Personal-Website/works/chat/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  
  "file_handlers": [
    {
      "action": "/My-Personal-Website/works/chat/open-file",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".gif", ".webp"],
        "video/*": [".mp4", ".webm", ".ogg"],
        "audio/*": [".mp3", ".wav", ".m4a", ".ogg"],
        "text/plain": [".txt"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  
  "prefer_related_applications": false,
  "related_applications": [],
  
  "screenshots_dark": [
    {
      "src": "/My-Personal-Website/works/chat/assets/screenshots/mobile-1-dark.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/screenshots/mobile-2-dark.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/screenshots/desktop-1-dark.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/My-Personal-Website/works/chat/assets/screenshots/desktop-2-dark.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ]
}
