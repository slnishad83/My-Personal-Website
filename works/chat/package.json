{
  "name": "nsl-chat",
  "version": "4.0.0",
  "description": "NSL Chat — Modern team messaging",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/run-all.js",
    "lint": "eslint . --ignore-pattern 'node_modules' --ignore-pattern 'dist' --ignore-pattern 'www' --ignore-pattern 'functions' --ignore-pattern 'tests' --ignore-pattern 'scripts' --ignore-pattern 'android' --ignore-pattern 'ios' --ignore-pattern 'electron' --ignore-pattern '*.min.js' --ignore-pattern 'twemoji'",
    "lint:fix": "eslint --fix . --ignore-pattern 'node_modules' --ignore-pattern 'dist' --ignore-pattern 'www' --ignore-pattern 'functions' --ignore-pattern 'tests' --ignore-pattern 'scripts' --ignore-pattern 'android' --ignore-pattern 'ios' --ignore-pattern 'electron' --ignore-pattern '*.min.js' --ignore-pattern 'twemoji'",
    "a11y": "pa11y http://localhost:3000/works/chat/dist/login.html http://localhost:3000/works/chat/dist/index.html",
    "sync:www": "node sync-www.js",
    "sync:android": "node sync-www.js && cap sync android",
    "sync:ios": "node sync-www.js && cap sync ios",
    "electron:dev": "npx electron .",
    "electron:build": "npx electron-builder --config electron-builder.yml",
    "electron:build:win": "npx electron-builder --config electron-builder.yml --win",
    "electron:build:mac": "npx electron-builder --config electron-builder.yml --mac",
    "electron:build:linux": "npx electron-builder --config electron-builder.yml --linux",
    "ios:setup": "bash scripts/setup-ios.sh",
    "ios:build": "npx cap sync ios && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -archivePath build/App.xcarchive archive"
  },
  "keywords": [
    "chat",
    "messaging",
    "team"
  ],
  "author": "Nishad SL",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anuradev/capacitor-background-mode": "^7.2.1",
    "@capacitor-community/contacts": "^7.2.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "acorn": "^8.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "pa11y": "^9.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  }
}
