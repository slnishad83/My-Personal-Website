{
  "name": "nsl-chat",
  "version": "6.0.0",
  "description": "NSL Chat — Modern team messaging",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node sync-www.js",
    "preview": "vite preview",
    "test": "node tests/run-all.js",
    "e2e": "playwright test",
    "lint": "eslint . --ignore-pattern 'node_modules' --ignore-pattern 'dist' --ignore-pattern 'www' --ignore-pattern 'assets' --ignore-pattern 'functions' --ignore-pattern 'tests' --ignore-pattern 'scripts' --ignore-pattern 'android' --ignore-pattern 'ios' --ignore-pattern 'electron' --ignore-pattern '*.min.js' --ignore-pattern 'twemoji'",
    "lint:fix": "eslint --fix . --ignore-pattern 'node_modules' --ignore-pattern 'dist' --ignore-pattern 'www' --ignore-pattern 'assets' --ignore-pattern 'functions' --ignore-pattern 'tests' --ignore-pattern 'scripts' --ignore-pattern 'android' --ignore-pattern 'ios' --ignore-pattern 'electron' --ignore-pattern '*.min.js' --ignore-pattern 'twemoji'",
    "a11y": "pa11y http://localhost:3000/works/chat/dist/login.html http://localhost:3000/works/chat/dist/index.html",
    "sync:www": "node sync-www.js",
    "sync:android": "node sync-www.js && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "sync:ios": "node sync-www.js && node node_modules/@capacitor/cli/bin/capacitor sync ios",
    "cap": "node node_modules/@capacitor/cli/bin/capacitor",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --config electron-builder.yml",
    "electron:build:win": "electron-builder --config electron-builder.yml --win",
    "electron:build:mac": "electron-builder --config electron-builder.yml --mac",
    "electron:build:linux": "electron-builder --config electron-builder.yml --linux",
    "ios:setup": "bash scripts/setup-ios.sh",
    "ios:build": "npm run sync:ios && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -archivePath build/App.xcarchive archive",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:all": "npm run build && firebase deploy",
    "update:all": "node sync-www.js && node node_modules/@capacitor/cli/bin/capacitor sync android && node node_modules/@capacitor/cli/bin/capacitor sync ios && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "update:web": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "prepare": "husky",
    "lint-staged": "eslint --fix"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{js,css,html}": []
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chat",
    "messaging",
    "team"
  ],
  "author": "Nishad SL",
  "homepage": "https://github.com/slnishad83/My-Personal-Website",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anuradev/capacitor-background-mode": "^7.2.1",
    "@capacitor-community/contacts": "^7.2.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "pa11y": "^9.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "acorn": "^8.17.0"
  }
}
