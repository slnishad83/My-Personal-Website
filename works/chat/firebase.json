{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".agents/**",
      ".codex/**",
      ".github/**",
      "node_modules/**",
      "tests/**",
      "android/**",
      "ios/**",
      "electron/**",
      "dist-electron/**",
      "scripts/**",
      "package*.json",
      "my-team-chat.apk"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
