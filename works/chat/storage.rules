rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Music uploads — users can upload/read/delete their own files
    match /music/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // Profile photos — reject SVG (XSS vector), enforce content type
    match /profilePhotos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('(image/jpeg|image/png|image/gif|image/webp|image/avif)/.*')
                   && !request.resource.contentType.matches('.*svg.*');
    }

    // Avatars (legacy path)
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('(image/jpeg|image/png|image/gif|image/webp)/.*')
                   && !request.resource.contentType.matches('.*svg.*');
    }

    // Chat attachments (legacy path) — ownership-based: writer must be in the chatId path prefix
    match /chatAttachments/{chatId}/{fileName} {
      allow read: if request.auth != null;
      // Legacy path — deny writes to prevent storage pollution. Use chat_uploads instead.
      allow write: if false;
    }

    // Chat uploads (current path — used by fixes.js and app-extras.js)
    match /chat_uploads/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('(image|video|audio|application|text)/.*')
                   && !request.resource.contentType.matches('.*svg.*');
    }

    // Playlist covers — ownership check via ownerUid field
    match /playlist-covers/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('(image/jpeg|image/png|image/gif|image/webp)/.*')
                   && !request.resource.contentType.matches('.*svg.*');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
