rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isExistingDirectParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/directChats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
    }

    function isDirectParticipantData(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function isAcceptedDirectChatRequest(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chatRequests/$(chatId))
        && get(/databases/$(database)/documents/chatRequests/$(chatId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/chatRequests/$(chatId)).data.fromUserId
          in request.resource.data.participants
        && get(/databases/$(database)/documents/chatRequests/$(chatId)).data.toUserId
          in request.resource.data.participants;
    }

    function isOwnSavedMessagesChat(data) {
      return data.saved == true
        && data.participants is list
        && data.participants.size() == 1
        && data.participants[0] == request.auth.uid;
    }

    function statusSettingsData(uid) {
      return exists(/databases/$(database)/documents/userSettings/$(uid))
        ? get(/databases/$(database)/documents/userSettings/$(uid)).data
        : {};
    }

    function statusContactsMap(uid) {
      let data = exists(/databases/$(database)/documents/userContacts/$(uid))
        ? get(/databases/$(database)/documents/userContacts/$(uid)).data.contacts
        : null;
      return data is map ? data : {};
    }

    function statusPrivacyData(uid) {
      let settings = statusSettingsData(uid).statusPrivacy;
      return settings is map ? settings : {};
    }

    function statusExceptUids(uid) {
      let list = statusPrivacyData(uid).exceptUids;
      return list is list ? list : [];
    }

    function statusShareUids(uid) {
      let list = statusPrivacyData(uid).shareWithUids;
      return list is list ? list : [];
    }

    function setsEqual(a, b) {
      return a.size() == b.size() && a.intersection(b).size() == a.size();
    }

    function isStatusVisibleToValid(uid, visibleTo, privacyMode) {
      return (visibleTo is list)
        && (uid in visibleTo)
        && (
          privacyMode == 'everyone'
            ? '*' in visibleTo && visibleTo.toSet().difference([uid].toSet()).size() <= 1
            : privacyMode == 'contacts'
              ? statusContactsMap(uid).keys().intersection(visibleTo.toSet().difference([uid].toSet())).size()
                  == visibleTo.toSet().difference([uid].toSet()).size()
              : privacyMode == 'contacts_except'
                ? setsEqual(statusContactsMap(uid).keys().difference(statusExceptUids(uid).toSet()), visibleTo.toSet().difference([uid].toSet()))
                : privacyMode == 'only_share'
                  ? setsEqual(statusShareUids(uid).toSet(), visibleTo.toSet().difference([uid].toSet()))
                  : false
        );
    }

    function isDirectMessageParticipant(data) {
      return signedIn() && (
        (data.directId is string && isExistingDirectParticipant(data.directId))
        || (data.participants is list && request.auth.uid in data.participants)
        || data.senderId == request.auth.uid
        || data.receiverId == request.auth.uid
        || data.toUserId == request.auth.uid
      );
    }

    function isRequestParticipant(data) {
      return signedIn()
        && (
          data.fromUserId == request.auth.uid
          || data.toUserId == request.auth.uid
          || data.fromEmail == request.auth.token.email
          || data.toEmail == request.auth.token.email
        );
    }

    function isPersonalOwner(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function isCallParticipant(data) {
      return signedIn()
        && (
          data.fromUserId == request.auth.uid
          || data.toUserId == request.auth.uid
          || (data.participantIds is list && request.auth.uid in data.participantIds)
        );
    }

    function isBroadcastMember(data) {
      return signedIn()
        && data.members is list
        && request.auth.uid in data.members;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && (
          (
            get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds is list
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          )
          || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && (
          (
            get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds is list
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds
          )
          || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );
    }

    function isChatMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isChatOrGroupParticipant(chatId) {
      return signedIn() && (
        (
          exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        )
        || (
          exists(/databases/$(database)/documents/groups/$(chatId))
          && (
            (
              get(/databases/$(database)/documents/groups/$(chatId)).data.memberIds is list
              && request.auth.uid in get(/databases/$(database)/documents/groups/$(chatId)).data.memberIds
            )
            || get(/databases/$(database)/documents/groups/$(chatId)).data.ownerId == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(chatId)).data.createdBy == request.auth.uid
          )
        )
      );
    }

    // typingStatus docs are keyed by "<type>:<chatId>" (e.g. "direct:uid1_uid2" or "group:<groupId>")
    // or by "<uid>_<messageId>" for thread typing. Reads/writes are scoped to chat participants.
    function isTypingStatusParticipant(chatKey) {
      let parts = chatKey.split(':');
      let type = parts[0];
      let cid = parts[1];
      return signedIn() && (
        (type == 'group' && cid is string && isGroupMember(cid))
        || (type == 'direct' && cid is string && (
            exists(/databases/$(database)/documents/chats/$(cid))
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.participants
        ))
        || isChatOrGroupParticipant(chatKey)
      );
    }

    // Disappearing messages: any chat participant may delete a message once the chat's
    // ephemeralTimer has elapsed since the message timestamp (self-destruct delete path).
    function isEphemeralMessageExpired(chatColl, chatId, messageData) {
      return signedIn()
        && !(messageData.kept == true)
        && exists(/databases/$(database)/documents/$(chatColl)/$(chatId))
        && get(/databases/$(database)/documents/$(chatColl)/$(chatId)).data.ephemeralTimer is int
        && get(/databases/$(database)/documents/$(chatColl)/$(chatId)).data.ephemeralTimer > 0
        && messageData.timestamp is timestamp
        && messageData.timestamp.toMillis() + get(/databases/$(database)/documents/$(chatColl)/$(chatId)).data.ephemeralTimer < request.time.toMillis();
    }

    function isCommunityCreator(data) {
      return signedIn() && data.createdBy == request.auth.uid;
    }

    function validMessageUpdate() {
      return (
        // Sender can edit text
        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'enc', 'e2e', 'edited', 'editedAt']))
        ||
        // Sender can delete for everyone (legacy boolean fields)
        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForEveryone', 'deletedForEveryoneBy']) && request.resource.data.deletedForEveryone == true)
        ||
        // Sender can delete for everyone (app writes type:'deleted' + media field removal)
        (resource.data.senderId == request.auth.uid
          && request.resource.data.type == 'deleted'
          && request.resource.data.deletedBy is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'type', 'deletedBy', 'deletedAt',
            'imageURL', 'videoURL', 'audioURL', 'fileURL', 'stickerURL', 'attachment'
          ])
        )
        ||
        // Participant check
        (
          (
            (resource.data.directId is string && isExistingDirectParticipant(resource.data.directId))
            || (resource.data.groupId is string && isGroupMember(resource.data.groupId))
            || (resource.data.participants is list && request.auth.uid in resource.data.participants)
            || (resource.data.participantEmails is list && request.auth.token.email in resource.data.participantEmails)
          )
          &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredTo'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll.votes'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll.closed'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'pinnedBy', 'pinnedAt'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isStarred'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kept', 'keptBy', 'keptAt'])
          )
        )
        ||
        // Any user can update their own delivery status
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredTo'])
          && request.auth.uid in request.resource.data.deliveredTo
        )
        ||
        // Any user can update their own read status
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.auth.uid in request.resource.data.readBy
        )
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'avatar', 'email', 'phone', 'phoneNumber', 'busyStatus', 'busyMessage', 'busySetAt',
          'blockedUsers', 'onlineStatus', 'lastSeen', 'typingIn', 'twofaEnabled',
          'appLockEnabled', 'emailVerified',
          'fcmTokens', 'messagingToken', 'isFirstTime', 'isActive', 'pendingVerification',
          'privacySettings', 'userAgent',
          'wallpaper', 'fontSize', 'themeMode', 'notificationSettings', 'language', 'notificationsEnabled',
          'lastHeartbeat', 'sessionId', 'platform', 'inCall', 'customStatus',
          'ghostMode', 'ghostContacts', 'ghostUpdatedAt',
          'pinnedChatIds', 'archivedChats', 'lockedChats', 'unreadChats',
          'chatFolders', 'contactDates', 'moodEmoji', 'moodUpdatedAt', 'screenshotRestrictions',
          'previousPhone', 'numberChangedAt', 'bio', 'chats',
          'deletionScheduledAt', 'deletedAt',
          'createdAt', 'deactivatedAt'
        ]);
      allow delete: if false;

      // Saved Messages (Bookmarks) subcollection
      match /savedMessages/{msgId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Backups subcollection (cloud backup/restore)
      match /backups/{backupId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Scheduled Messages subcollection
      match /scheduledMessages/{msgId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Sessions subcollection (multi-device support)
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Call Events subcollection
      match /callEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Pairing tokens (multi-device)
      match /pairingTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // User settings
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // User notifications
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Unread counts
      match /unreadCounts/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Muted chats per user
      match /mutedChats/{chatId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Per-user status privacy settings (statusPrivacy: {mode, exceptUids, shareWithUids})
    match /userSettings/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Per-user contact map (direct chat partners, synced client-side)
    match /userContacts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // PIN secrets — private per-user, owner only (accessed by Cloud Functions via server SDK)
    match /userSecrets/{uid} {
      allow read, write: if isOwner(uid);
    }

    // E2E public keys — any signed-in user can read, owner can write
    match /userPublicKeys/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    match /directChats/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow update: if isExistingDirectParticipant(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'name', 'photoURL', 'participants', 'participantNames', 'participantPhotos', 'type',
          'saved', 'lastMessage', 'lastMessageText', 'lastMessageTime', 'lastMessageAt',
          'unreadCount', 'typing', 'muted', 'mutedUntil', 'updatedAt', 'ephemeralTimer',
          'lastSenderId', 'lastMessageSenderId', 'lastMessageSenderName', 'lastMessageFrom', 'unread'
        ]);
      allow delete: if isExistingDirectParticipant(chatId);
      allow create: if isDirectParticipantData(request.resource.data)
        && (
          isOwnSavedMessagesChat(request.resource.data)
          || isAcceptedDirectChatRequest(chatId)
          || (signedIn() && request.resource.data.participants.size() == 2
            && request.auth.uid in request.resource.data.participants
            && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
            && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1])))
        );
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (
        (resource.data.directId is string && isExistingDirectParticipant(resource.data.directId))
        || (resource.data.groupId is string && isGroupMember(resource.data.groupId))
        || (resource.data.participants is list && request.auth.uid in resource.data.participants)
        || resource.data.senderId == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
        && (
        (request.resource.data.directId is string && isExistingDirectParticipant(request.resource.data.directId))
        || (request.resource.data.groupId is string && isGroupMember(request.resource.data.groupId))
        || (request.resource.data.receiverId is string && request.resource.data.receiverId == request.auth.uid)
        || (request.resource.data.chatId is string && isChatOrGroupParticipant(request.resource.data.chatId))
      );
      allow update: if signedIn() && (
        (
          validMessageUpdate()
          && (
            isDirectMessageParticipant(resource.data)
            || (resource.data.groupId is string && isGroupMember(resource.data.groupId))
            || (resource.data.participantEmails is list && request.auth.token.email in resource.data.participantEmails)
            || isChatOrGroupParticipant(messageId)
          )
        )
        ||
        // Chat-preview fields on the parent chat doc (Schema B voice/forward writers)
        (
          isChatOrGroupParticipant(messageId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageTime', 'lastMessageFrom', 'lastMessageSenderId',
            'lastMessageSenderName', 'unread', 'readStatus'
          ])
        )
      );
      allow delete: if signedIn() && (
        resource.data.senderId == request.auth.uid
        || (resource.data.directId is string && isExistingDirectParticipant(resource.data.directId)
            && isEphemeralMessageExpired('directChats', resource.data.directId, resource.data))
        || (resource.data.groupId is string && isGroupMember(resource.data.groupId)
            && isEphemeralMessageExpired('groups', resource.data.groupId, resource.data))
      );

      // Thread Replies subcollection
      match /threadReplies/{replyId} {
        allow read: if signedIn() && (
          (resource.data.directId is string && isExistingDirectParticipant(resource.data.directId))
          || (resource.data.groupId is string && isGroupMember(resource.data.groupId))
          || (resource.data.participants is list && request.auth.uid in resource.data.participants)
          || resource.data.senderId == request.auth.uid
        );
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'senderId', 'senderName', 'senderPhoto', 'text', 'type',
            'directId', 'groupId', 'participants', 'participantEmails',
            'timestamp', 'edited', 'attachments', 'replyTo'
          ])
          && (
            (request.resource.data.directId is string && isExistingDirectParticipant(request.resource.data.directId))
            || (request.resource.data.groupId is string && isGroupMember(request.resource.data.groupId))
            || (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants)
          );
        allow update: if signedIn() && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'edited', 'deletedFor', 'deletedForEveryone', 'deletedForEveryoneBy'
          ]);
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }

      // Legacy per-chat messages subcollection (Schema B: voice-messages, forward-modal, screen-share, reactions, edit, star, seen-by)
      match /items/{itemId} {
        allow read: if signedIn() && isChatOrGroupParticipant(messageId);
        allow create: if signedIn()
          && isChatOrGroupParticipant(messageId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn()
          && isChatOrGroupParticipant(messageId)
          && (
            (
              resource.data.senderId == request.auth.uid
              &&               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'enc', 'e2e', 'edited', 'editedAt', 'attachment', 'reactions', 'status',
                'deletedFor', 'deletedForEveryone', 'deletedForEveryoneBy',
                'type', 'deletedBy', 'deletedAt',
                'imageURL', 'videoURL', 'audioURL', 'fileURL', 'stickerURL',
                'starred', 'starredAt', 'starredBy'
              ])
            )
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starred', 'starredAt', 'starredBy'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) && request.auth.uid in request.resource.data.readBy)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredTo', 'status'])
          );
        allow delete: if false;
      }
    }


    match /chatRequests/{requestId} {
      allow read: if resource == null || isRequestParticipant(resource.data);
      allow create: if isRequestParticipant(request.resource.data)
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fromUserId', 'fromUserName', 'fromUserEmail', 'toUserId', 'toUserName', 'toUserEmail',
          'status', 'createdAt', 'respondedAt'
        ])
        && (
          !exists(/databases/$(database)/documents/directChats/$(requestId))
          || (
            exists(/databases/$(database)/documents/directChats/$(requestId))
            && get(/databases/$(database)/documents/directChats/$(requestId)).data.status == 'deleted'
          )
        )
        && request.resource.data.status == 'pending';
      allow update: if isRequestParticipant(resource.data)
        && (
          (
            resource.data.status == 'pending'
            && resource.data.toUserId == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.fromUserId == resource.data.fromUserId
            && request.resource.data.toUserId == resource.data.toUserId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'respondedAt'
            ])
          )
          || (
            resource.data.status == 'pending'
            && resource.data.fromUserId == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.fromUserId == resource.data.fromUserId
            && request.resource.data.toUserId == resource.data.toUserId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'respondedAt'
            ])
          )
          || (
            resource.data.status in ['declined', 'cancelled']
            && request.resource.data.status == 'pending'
            && request.resource.data.fromUserId == request.auth.uid
            && request.resource.data.toUserId != request.auth.uid
            && (
              !exists(/databases/$(database)/documents/directChats/$(requestId))
              || (
                exists(/databases/$(database)/documents/directChats/$(requestId))
                && get(/databases/$(database)/documents/directChats/$(requestId)).data.status == 'deleted'
              )
            )
            && request.resource.data.fromUserId in [
              resource.data.fromUserId,
              resource.data.toUserId
            ]
            && request.resource.data.toUserId in [
              resource.data.fromUserId,
              resource.data.toUserId
            ]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'fromUserId',
              'fromUserName',
              'fromUserEmail',
              'toUserId',
              'toUserName',
              'toUserEmail',
              'status',
              'createdAt',
              'respondedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /inAppNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.toUserId == request.auth.uid
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /broadcasts/{broadcastId} {
      allow read: if isBroadcastMember(resource.data);
      allow create: if isBroadcastMember(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isBroadcastMember(resource.data)
        && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn()
          && isBroadcastMember(get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data);
        allow create: if signedIn()
          && isBroadcastMember(get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data)
          && get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.ownerId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /communities/{communityId} {
      allow read: if signedIn()
        && (resource.data.createdBy == request.auth.uid
            || (resource.data.memberIds is list && request.auth.uid in resource.data.memberIds));
      allow create: if isCommunityCreator(request.resource.data);
      allow update, delete: if isCommunityCreator(resource.data);
    }

    match /communityMembers/{memberId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || (resource.data.communityId is string
                && exists(/databases/$(database)/documents/communities/$(resource.data.communityId))
                && (get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.createdBy == request.auth.uid
                    || (get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.memberIds is list
                        && request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.memberIds))));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.communityId is string
        && exists(/databases/$(database)/documents/communities/$(request.resource.data.communityId))
        && (
          (get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.memberIds is list
            && request.auth.uid in get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.memberIds)
          || get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.createdBy == request.auth.uid
        );
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /communityGroups/{communityId}/groups/{groupId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId))
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.memberIds;
      allow create, update, delete: if signedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId))
        && get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.adminIds is list
        && request.auth.uid in request.resource.data.adminIds;
      allow update: if isGroupAdmin(groupId)
        || (
          isGroupMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'unreadCounts', 'unreadCount', 'lastMessage', 'lastMessageText', 'lastMessageAt',
            'lastMessageTime', 'lastSenderId', 'lastMessageSenderId', 'lastMessageSenderName', 'lastMessageFrom',
            'unread', 'updatedAt', 'ephemeralTimer'
          ])
        );
      allow delete: if isGroupAdmin(groupId);

      match /members/{memberId} {
        allow read: if signedIn() && isGroupMember(groupId);
        allow create: if signedIn() && (
          request.auth.uid == memberId
          || isGroupAdmin(groupId)
        );
        allow update: if signedIn() && (
          request.auth.uid == memberId
          || isGroupAdmin(groupId)
        );
        allow delete: if signedIn() && (
          request.auth.uid == memberId
          || isGroupAdmin(groupId)
        );
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isGroupMember(groupId) && (
          validMessageUpdate()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll.votes'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll.closed'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starred', 'starredAt', 'starredBy'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'pinnedBy', 'pinnedAt'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isStarred'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) && request.auth.uid in request.resource.data.readBy)
        );
        allow delete: if resource.data.senderId == request.auth.uid || isGroupAdmin(groupId)
          || (isGroupMember(groupId) && isEphemeralMessageExpired('groups', groupId, resource.data));
      }
    }

    match /groupMembers/{memberId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isGroupMember(resource.data.groupId));
      allow create: if signedIn()
        && (
          (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'member'
            && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.isPublic == true
          )
          || isGroupAdmin(request.resource.data.groupId)
        );
      allow update: if signedIn()
        && (
          isGroupAdmin(resource.data.groupId)
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.groupId == resource.data.groupId
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'userId', 'groupId', 'role', 'displayName', 'photoURL', 'joinedAt', 'customTitle', 'lastSeen'
            ])
          )
        );
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isGroupAdmin(resource.data.groupId));
    }

    match /groupKeys/{chatId} {
      allow read, create, update: if isGroupMember(chatId);
      allow delete: if isGroupAdmin(chatId);
    }

    match /groupInvites/{inviteId} {
      allow read: if isRequestParticipant(resource.data);
      allow create: if isRequestParticipant(request.resource.data)
        && request.resource.data.fromUserId == request.auth.uid
        && isGroupAdmin(request.resource.data.groupId)
        && request.resource.data.status == 'pending';
      allow update: if isRequestParticipant(resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'respondedAt'
        ])
        && (
          (
            resource.data.toUserId == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined']
          )
          || (
            resource.data.fromUserId == request.auth.uid
            && request.resource.data.status == 'cancelled'
          )
        );
      allow delete: if false;
    }

    match /blockedUsers/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /favoriteChats/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /archivedChats/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /lockedChats/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /chatLockSettings/{docId} {
      allow read: if isOwner(docId) || isPersonalOwner(resource.data);
      allow update, delete: if isOwner(docId) && isPersonalOwner(resource.data);
      allow create: if isOwner(docId) && isPersonalOwner(request.resource.data);
    }

    match /appLockSettings/{docId} {
      allow read: if isOwner(docId) || isPersonalOwner(resource.data);
      allow update, delete: if isOwner(docId) && isPersonalOwner(resource.data);
      allow create: if isOwner(docId) && isPersonalOwner(request.resource.data);
    }

    match /chatTranslationSettings/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /chatNotifSettings/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /userSessions/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /blockedWords/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /chatRequestsRead/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /chatRequestsSnooze/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /userReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /messageReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if false;
      allow update, delete: if false;
    }

    match /screenshotAttempts/{attemptId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /groupCalls/{callId} {
      allow read: if signedIn() && (
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)
        || resource.data.hostUserId == request.auth.uid
        || resource.data.initiatorId == request.auth.uid
      );
      allow create: if signedIn() && (
        request.resource.data.hostUserId == request.auth.uid
        || request.resource.data.initiatorId == request.auth.uid
      ) && (!('participantIds' in request.resource.data) || (request.resource.data.participantIds is list && request.resource.data.participantIds.size() <= 32));
      allow update: if signedIn() && (
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)
        || resource.data.hostUserId == request.auth.uid
        || resource.data.initiatorId == request.auth.uid
      ) && (!('participantIds' in request.resource.data) || (request.resource.data.participantIds is list && request.resource.data.participantIds.size() <= 32));
      allow delete: if signedIn() && (
        resource.data.hostUserId == request.auth.uid
        || resource.data.initiatorId == request.auth.uid
      );

      match /signaling/{docId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(callId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.sender == request.auth.uid;
        allow update, delete: if false;
      }
      match /candidates/{docId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(callId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.sender == request.auth.uid;
        allow update, delete: if false;
      }
      match /invites/{inviteId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(callId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groupCalls/$(callId)).data.participantIds;
        allow update, delete: if signedIn() && resource.data.fromUserId == request.auth.uid;
      }
    }

    match /groupCallInvites/{inviteId} {
      allow read: if signedIn() && (
        resource.data.toUserId == request.auth.uid
        || resource.data.fromUserId == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.toUserId == request.auth.uid
        || resource.data.fromUserId == request.auth.uid
      );
      allow delete: if signedIn() && (
        resource.data.toUserId == request.auth.uid
        || resource.data.fromUserId == request.auth.uid
      );
    }

    match /stickerPacks/{packId} {
      allow read: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == request.auth.uid;
    }

    match /animatedStickerPacks/{packId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
    }

    match /joinRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /groupJoinRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || isGroupAdmin(resource.data.groupId));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && isGroupAdmin(resource.data.groupId)
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }

    match /groupActivityLog/{entryId} {
      allow read: if signedIn() && isGroupMember(resource.data.groupId);
      allow create: if signedIn()
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.type in [
          'member_joined', 'member_left', 'admin_promoted', 'admin_demoted',
          'description_changed', 'photo_changed', 'name_changed', 'group_created'
        ]
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{path=**}/chatTags/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /deletedChats/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /mutedChats/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /quickReplies/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /pinnedMessages/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /starredMessages/{docId} {
      allow read, update, delete: if isPersonalOwner(resource.data);
      allow create: if isPersonalOwner(request.resource.data);
    }

    match /messageReactions/{docId} {
      allow read: if signedIn() && (
        (resource.data.directId is string && isExistingDirectParticipant(resource.data.directId))
        || (resource.data.groupId is string && isGroupMember(resource.data.groupId))
        || (resource.data.participants is list && request.auth.uid in resource.data.participants)
        || resource.data.userId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.chatId is string
        && (
          (request.resource.data.directId is string && isExistingDirectParticipant(request.resource.data.directId))
          || (request.resource.data.groupId is string && isGroupMember(request.resource.data.groupId))
          || request.resource.data.chatType == 'channel'
        );
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /typingIndicators/{docId} {
      allow read: if signedIn() && (
        resource.data.chatId is string
        && (
          (resource.data.directId is string && isExistingDirectParticipant(resource.data.directId))
          || (resource.data.groupId is string && isGroupMember(resource.data.groupId))
        )
      );
      allow create, update: if signedIn()
        && request.auth.uid == request.resource.data.userId;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /statuses/{statusId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (
          resource.data.visibleTo is list
          && (request.auth.uid in resource.data.visibleTo || '*' in resource.data.visibleTo)
        )
      );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.visibleTo is list
        && request.resource.data.visibleTo.size() <= 2001
        && isStatusVisibleToValid(request.auth.uid, request.resource.data.visibleTo, request.resource.data.privacyMode);
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
            && request.auth.uid in request.resource.data.seenBy)
      );
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    match /calls/{callId} {
      allow read, update, delete: if isCallParticipant(resource.data);
      allow create: if isCallParticipant(request.resource.data)
        && request.resource.data.fromUserId == request.auth.uid;

      match /{sub=**} {
        allow read, write: if signedIn()
          && exists(/databases/$(database)/documents/calls/$(callId))
          && isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
      }
    }

    match /scheduledCalls/{docId} {
      allow read: if signedIn() && (
        resource.data.participantIds is list && request.auth.uid in resource.data.participantIds
        || resource.data.participants is list && request.auth.uid in resource.data.participants
      );
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read, create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /callLogs/{callLogId} {
      allow read: if signedIn() && (
        resource.data.participants is list && request.auth.uid in resource.data.participants
        || resource.data.callerId == request.auth.uid
        || resource.data.calleeId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read', 'starred', 'deletedFor'
        ]);
      allow delete: if false;
    }
    match /calendarEvents/{eventId} {
      allow read: if signedIn() && (resource.data.addedBy == request.auth.uid
        || (resource.data.participants is list && request.auth.uid in resource.data.participants));
      allow create: if signedIn() && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.addedBy == request.auth.uid;
    }
    match /groupExpenses/{expId} {
      allow read: if signedIn() && (resource.data.addedBy == request.auth.uid
        || (resource.data.participants is list && request.auth.uid in resource.data.participants)
        || (resource.data.groupId is string && isGroupMember(resource.data.groupId)));
      allow create: if signedIn() && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.addedBy == request.auth.uid;
    }
    match /typingStatus/{chatKey} {
      allow read: if signedIn() && (
        (resource.data.userId is string && resource.data.userId == request.auth.uid)
        || isTypingStatusParticipant(chatKey)
      );
      allow create, update: if signedIn() && (
        (request.resource.data.userId is string && request.resource.data.userId == request.auth.uid)
        || isTypingStatusParticipant(chatKey)
      );
      allow delete: if signedIn() && (
        (resource.data.userId is string && resource.data.userId == request.auth.uid)
        || isTypingStatusParticipant(chatKey)
      );
    }
    match /meetings/{meetingId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid == request.resource.data.createdBy;
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'name', 'description', 'participants', 'scheduledAt', 'duration'
        ]);
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }
    match /channels/{channelId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'members', 'createdBy', 'createdAt', 'photoURL', 'type'
        ]);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'photoURL', 'members'
        ])
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /groupChats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'members', 'createdBy', 'createdAt', 'description', 'photoURL'
        ]);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'photoURL', 'members'
        ]);
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants', 'participantEmails', 'participantNames', 'participantPhotos',
          'createdBy', 'createdAt', 'updatedAt', 'lastMessageAt', 'type', 'saved', 'status',
          'muted', 'mutedUntil', 'ephemeralTimer'
        ]);
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'name', 'photoURL', 'participants', 'participantNames', 'participantPhotos',
          'unreadCounts', 'unreadCount', 'unread',
          'lastMessage', 'lastMessageText', 'lastMessageAt', 'lastMessageTime',
          'lastSenderId', 'lastMessageSenderId', 'lastMessageSenderName', 'lastMessageFrom',
          'updatedAt', 'saved', 'muted', 'mutedUntil', 'ephemeralTimer', 'type',
          'lastReadMessageId', 'archived', 'pinned', 'pinnedAt'
        ]);
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isChatMember(chatId);
        allow delete: if false;
      }
      match /readStatus/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId
          || isChatMember(chatId));
        allow write: if signedIn() && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isChatMember(chatId) && (
          validMessageUpdate()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll.votes'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll.closed'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starred', 'starredAt', 'starredBy'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'pinnedBy', 'pinnedAt'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isStarred'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) && request.auth.uid in request.resource.data.readBy)
        );
        allow delete: if resource.data.senderId == request.auth.uid
          || (isChatMember(chatId) && isEphemeralMessageExpired('chats', chatId, resource.data));
      }
    }
    match /notificationTelemetry/{entryId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /musicLibrary/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId;
    }
    match /playlists/{playlistId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.ownerId
        || (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators)
        || resource.data.isPublic == true
      );
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /whiteboards/{boardId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
      match /strokes/{strokeId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/whiteboards/$(boardId)).data.participants;
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/whiteboards/$(boardId)).data.participants;
        allow update, delete: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      }
    }
    match /reminders/{reminderId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ── WS1: Missing collection rules ────────────────────────────
    match /liveLocations/{docId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (resource.data.sharedWith is list && request.auth.uid in resource.data.sharedWith)
      );
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (resource.data.sharedWith is list && request.auth.uid in resource.data.sharedWith)
      );
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /playlistFolders/{folderId} {
      allow read, write: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /listeningRooms/{roomId} {
      allow read: if signedIn() && (
        resource.data.hostId == request.auth.uid
        || request.auth.uid in resource.data.participants
        || resource.data.isPublic == true
      );
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn() && resource.data.hostId == request.auth.uid;
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /votes/{trackId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/listeningRooms/$(roomId)).data.participants;
      }
      match /chat/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/listeningRooms/$(roomId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/listeningRooms/$(roomId)).data.participants;
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
