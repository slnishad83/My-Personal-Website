rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isAuth() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // =============================================
    // USERS
    // =============================================
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Call events subcollection
      match /callEvents/{callId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Saved Messages (Bookmarks) subcollection
      match /savedMessages/{msgId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Scheduled Messages subcollection
      match /scheduledMessages/{msgId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // =============================================
    // MESSAGES
    // =============================================
    match /messages/{messageId} {
      // Direct messages: user must be a participant.
      // Group messages: user must be a member of the group.
      allow read: if isAuth() && (
        request.auth.uid in resource.data.participants
        ||
        (resource.data.groupId != null && isGroupMember(resource.data.groupId))
      );
      // Create: sender must match auth, and must be a participant of the target chat.
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.senderId
        && (
          // Direct chat: sender must be in participants
          (request.resource.data.chatType == 'direct' && request.auth.uid in request.resource.data.participants)
          // Group chat: sender must be a group member
          || (request.resource.data.groupId != null && isGroupMember(request.resource.data.groupId))
        );
      // Update: only allow status, readBy, reactions fields to be modified by participants.
      // Do NOT allow modifying senderId, senderName, text, chatId, chatType, or other fields.
      allow update: if isAuth() && (
        request.auth.uid in resource.data.participants
        || (resource.data.groupId != null && isGroupMember(resource.data.groupId))
      ) && (
        // Only these specific fields may be modified:
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readBy', 'reactions', 'starred'])
      );
      allow delete: if isAuth() && request.auth.uid == resource.data.senderId;

      // Thread replies subcollection — requires auth + participant check
      match /threadReplies/{replyId} {
        allow read: if isAuth() && request.auth.uid in resource.data.participants;
        allow create: if isAuth() && request.auth.uid == request.resource.data.senderId;
        // Thread updates restricted to status/readBy only, by participants
        allow update: if isAuth() && request.auth.uid in resource.data.participants;
        allow delete: if false;
      }
    }

    // =============================================
    // DIRECT CHATS
    // =============================================
    match /directChats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    // =============================================
    // GROUP CHATS
    // =============================================
    match /groupChats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth() && request.auth.uid in request.resource.data.members;
      allow update: if isAuth() && request.auth.uid in resource.data.members;
      // Roles field can only be modified by existing admins
      allow update: if isAuth() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles'])
        && request.auth.uid in resource.data.roles[resource.data.adminIds[0]];
      allow delete: if false;
    }

    // =============================================
    // CHATS (legacy direct chat metadata)
    // =============================================
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow update: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if false;
      allow delete: if false;
    }

    // =============================================
    // GROUPS
    // =============================================
    match /groups/{groupId} {
      allow read: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow update: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuth();
      allow delete: if false;

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuth() && isGroupMember(groupId);
        allow write: if false;
      }
    }

    // =============================================
    // GROUP MEMBERS (flat collection)
    // =============================================
    match /groupMembers/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isGroupMember(resource.data.groupId)
      );
      allow write: if false;
    }

    // =============================================
    // CHAT REQUESTS
    // =============================================
    match /chatRequests/{requestId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.toUserId ||
        request.auth.uid == resource.data.fromUserId
      );
      allow delete: if false;
    }

    // =============================================
    // GROUP INVITES
    // =============================================
    match /groupInvites/{inviteId} {
      allow read: if isAuth() && request.auth.uid == resource.data.toUserId;
      // Create: inviter must be the fromUserId and must be a group member
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.fromUserId
        && isGroupMember(request.resource.data.groupId);
      // Update: only the recipient (toUserId) can accept/decline
      allow update: if isAuth() && request.auth.uid == resource.data.toUserId;
      allow delete: if isAuth() && request.auth.uid == resource.data.fromUserId;
    }

    // =============================================
    // PINNED MESSAGES
    // =============================================
    match /pinnedMessages/{pinId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid == request.resource.data.pinnedBy;
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // =============================================
    // TASKS
    // =============================================
    match /tasks/{taskId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // =============================================
    // TYPING INDICATORS
    // =============================================
    match /typingIndicators/{docId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow write: if isAuth() && request.auth.uid == request.resource.data.userId;
    }

    // =============================================
    // TYPING STATUS
    // =============================================
    match /typingStatus/{docId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow write: if isAuth() && request.auth.uid == request.resource.data.userId;
    }

    // =============================================
    // IN-APP NOTIFICATIONS
    // =============================================
    match /inAppNotifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.toUserId;
      allow update: if isAuth() && request.auth.uid == resource.data.toUserId;
      allow create: if false;
      allow delete: if isAuth() && request.auth.uid == resource.data.toUserId;
    }

    // =============================================
    // NOTIFICATION TELEMETRY
    // =============================================
    match /notificationTelemetry/{telemetryId} {
      allow read: if false;
      // M8: Only allow the owning user to create their own telemetry
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // =============================================
    // CHAT REQUEST SNOOZE
    // =============================================
    match /chatRequestsSnooze/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // =============================================
    // CALENDAR EVENTS
    // =============================================
    match /calendarEvents/{eventId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.addedBy
        || (resource.data.participants is list && request.auth.uid in resource.data.participants)
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.addedBy;
      allow update: if isAuth() && request.auth.uid == resource.data.addedBy;
      allow delete: if isAuth() && request.auth.uid == resource.data.addedBy;
    }

    // =============================================
    // GROUP EXPENSES
    // =============================================
    match /groupExpenses/{expenseId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.addedBy
        || (resource.data.participants is list && request.auth.uid in resource.data.participants)
        || (resource.data.groupId != null && isGroupMember(resource.data.groupId))
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.addedBy;
      allow update: if isAuth() && request.auth.uid == resource.data.addedBy;
      allow delete: if isAuth() && request.auth.uid == resource.data.addedBy;
    }

    // =============================================
    // SCHEDULED CALLS
    // =============================================
    match /scheduledCalls/{callId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid == request.resource.data.creatorId;
      allow update: if isAuth();
      allow delete: if false;
    }

    // =============================================
    // MEETINGS
    // =============================================
    match /meetings/{meetingId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid == request.resource.data.createdBy;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if isAuth() && request.auth.uid == resource.data.createdBy;
    }

    // =============================================
    // CHANNELS
    // =============================================
    match /channels/{channelId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth() && request.auth.uid in resource.data.members;
      allow update: if isAuth() && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    // =============================================
    // CALL LOGS
    // =============================================
    match /callLogs/{logId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    // =============================================
    // MUSIC LIBRARY
    // =============================================
    match /musicLibrary/{trackId} {
      allow read: if isAuth() && request.auth.uid == resource.data.addedBy;
      allow create: if isAuth() && request.auth.uid == request.resource.data.addedBy;
      allow update: if isAuth() && request.auth.uid == resource.data.addedBy;
      allow delete: if isAuth() && request.auth.uid == resource.data.addedBy;
    }

    // =============================================
    // PLAYLISTS
    // =============================================
    match /playlists/{playlistId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.ownerUid || request.auth.uid in resource.data.collaborators);
      allow create: if isAuth() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isAuth() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.collaborators
      );
      allow delete: if isAuth() && request.auth.uid == resource.data.ownerUid;
    }

    // =============================================
    // LISTENING ROOMS
    // =============================================
    match /listeningRooms/{chatId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.hostUid
        || request.auth.uid in resource.data.participants
        || request.auth.uid in resource.data.coHosts
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.hostUid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.hostUid
        || request.auth.uid in resource.data.coHosts
      );
      allow delete: if isAuth() && request.auth.uid == resource.data.hostUid;
    }

    // =============================================
    // WHITEBOARDS (collaborative drawing sessions)
    // =============================================
    match /whiteboards/{sessionId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.createdBy || request.auth.uid in resource.data.participants);
      allow create: if isAuth();
      allow update: if isAuth() && (request.auth.uid == resource.data.createdBy || request.auth.uid in resource.data.participants);
      allow delete: if isAuth() && request.auth.uid == resource.data.createdBy;

      match /strokes/{strokeId} {
        allow read: if isAuth() && (request.auth.uid in get(/databases/$(database)/documents/whiteboards/$(sessionId)).data.participants || request.auth.uid == get(/databases/$(database)/documents/whiteboards/$(sessionId)).data.createdBy);
        allow create: if isAuth() && (request.auth.uid in get(/databases/$(database)/documents/whiteboards/$(sessionId)).data.participants || request.auth.uid == get(/databases/$(database)/documents/whiteboards/$(sessionId)).data.createdBy);
        allow update: if isAuth() && request.auth.uid == resource.data.createdBy;
        allow delete: if isAuth() && request.auth.uid == resource.data.createdBy;
      }
    }

    // =============================================
    // REMINDERS (date-based reminders from date-reminders.js)
    // =============================================
    match /reminders/{reminderId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // =============================================
    // SCHEDULED MESSAGES (top-level — features-addon.js)
    // =============================================
    match /scheduledMessages/{msgId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }
  }
}
