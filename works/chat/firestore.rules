rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isAuth() && (
        exists(/databases/$(database)/documents/directChats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members
      ) || (
        exists(/databases/$(database)/documents/groupChats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groupChats/$(chatId)).data.members
      );
    }

    function isGroupMember(groupId) {
      return isAuth() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // =============================================
    // USERS
    // =============================================
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Call events subcollection
      match /callEvents/{callId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // =============================================
    // MESSAGES
    // =============================================
    match /messages/{messageId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in resource.data.readBy ||
        resource.data.senderId == request.auth.uid
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.senderId;
      allow update: if isAuth();
      allow delete: if false;

      // Thread replies subcollection
      match /threadReplies/{replyId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.auth.uid == request.resource.data.senderId;
        allow update: if isAuth();
        allow delete: if false;
      }
    }

    // =============================================
    // DIRECT CHATS
    // =============================================
    match /directChats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow create: if isAuth();
      allow update: if isAuth() && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    // =============================================
    // GROUP CHATS
    // =============================================
    match /groupChats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    // =============================================
    // CHATS (legacy direct chat metadata)
    // =============================================
    match /chats/{chatId} {
      allow read: if isAuth();
      allow update: if isAuth();
      allow create: if false;
      allow delete: if false;
    }

    // =============================================
    // GROUPS
    // =============================================
    match /groups/{groupId} {
      allow read: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow update: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuth();
      allow delete: if false;

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuth() && isGroupMember(groupId);
        allow write: if false;
      }
    }

    // =============================================
    // GROUP MEMBERS (flat collection)
    // =============================================
    match /groupMembers/{docId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // =============================================
    // CHAT REQUESTS
    // =============================================
    match /chatRequests/{requestId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow create: if isAuth() && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.toUserId ||
        request.auth.uid == resource.data.fromUserId
      );
      allow delete: if false;
    }

    // =============================================
    // GROUP INVITES
    // =============================================
    match /groupInvites/{inviteId} {
      allow read: if isAuth() && request.auth.uid == resource.data.toUserId;
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // =============================================
    // PINNED MESSAGES
    // =============================================
    match /pinnedMessages/{pinId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.pinnedBy;
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // =============================================
    // SCHEDULED MESSAGES
    // =============================================
    match /scheduledMessages/{msgId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }

    // =============================================
    // TASKS
    // =============================================
    match /tasks/{taskId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuth() && request.auth.uid == resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // =============================================
    // TYPING INDICATORS
    // =============================================
    match /typingIndicators/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // =============================================
    // TYPING STATUS
    // =============================================
    match /typingStatus/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // =============================================
    // IN-APP NOTIFICATIONS
    // =============================================
    match /inAppNotifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.toUserId;
      allow update: if isAuth() && request.auth.uid == resource.data.toUserId;
      allow create: if false;
      allow delete: if isAuth() && request.auth.uid == resource.data.toUserId;
    }

    // =============================================
    // NOTIFICATION TELEMETRY
    // =============================================
    match /notificationTelemetry/{telemetryId} {
      allow read: if false;
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }

    // =============================================
    // CHAT REQUEST SNOOZE
    // =============================================
    match /chatRequestsSnooze/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // =============================================
    // CALENDAR EVENTS
    // =============================================
    match /calendarEvents/{eventId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid == request.resource.data.addedBy;
      allow update: if isAuth();
      allow delete: if false;
    }

    // =============================================
    // GROUP EXPENSES
    // =============================================
    match /groupExpenses/{expenseId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.addedBy;
      allow update: if isAuth();
      allow delete: if false;
    }

    // =============================================
    // SCHEDULED CALLS
    // =============================================
    match /scheduledCalls/{callId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid == request.resource.data.creatorId;
      allow update: if isAuth();
      allow delete: if false;
    }

    // =============================================
    // CALL LOGS
    // =============================================
    match /callLogs/{logId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }
  }
}
