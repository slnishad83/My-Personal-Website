rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isUid(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isUid(userId);
      allow update: if isUid(userId);
      allow delete: if false;

      match /callEvents/{eventId} {
        allow read: if isUid(userId);
        allow write: if isUid(userId);
      }

      match /mutedChats/{docId} {
        allow read: if isUid(userId);
        allow write: if isUid(userId);
      }

      match /{subcollection=**} {
        allow read: if isUid(userId);
        allow write: if isUid(userId);
      }
    }

    match /chats/{chatId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;

      match /items/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth();
      }

      match /threadReplies/{replyId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth();
      }
    }

    match /directChats/{chatId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /groups/{groupId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();

      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth();
      }

      match /{subcollection=**} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    match /messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();

      match /items/{itemId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth();
      }

      match /threadReplies/{replyId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth();
      }
    }

    match /calls/{callId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /groupCalls/{callId} {
      allow read: if isAuth();
      allow write: if isAuth();
      allow delete: if false;

      match /{subcollection=**} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    match /starredMessages/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /scheduledMessages/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /tasks/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /reminders/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /calendarEvents/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /pinnedMessages/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /whiteboards/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /statuses/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /liveLocations/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /meetings/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /userReports/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /channels/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /userPublicKeys/{userId} {
      allow read: if isAuth();
      allow write: if isUid(userId);
    }

    match /callEvents/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /groupMembers/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
