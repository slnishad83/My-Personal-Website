// ============================================================
// STORAGE SECURITY RULES - TEAM CHAT 2026
// Controls access to uploaded media files
// ============================================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(ownerId) {
      return request.auth.uid == ownerId;
    }
    
    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isVideoFile() {
      return request.resource.contentType.matches('video/.*');
    }
    
    function isAudioFile() {
      return request.resource.contentType.matches('audio/.*');
    }
    
    function isValidMediaFile() {
      return isImageFile() || isVideoFile() || isAudioFile();
    }
    
    function fileSizeLimit(size) {
      return request.resource.size <= size;
    }
    
    // ========================================================
    // USER AVATARS - {userId}/avatar
    // ========================================================
    match /avatars/{userId}/{allPaths=**} {
      // User can upload own avatar
      allow write: if isAuthenticated() && 
                      isOwner(userId) && 
                      isImageFile() && 
                      fileSizeLimit(5 * 1024 * 1024); // 5MB limit
      
      // Anyone can read avatars
      allow read: if isAuthenticated();
      
      // User can delete own avatar
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ========================================================
    // CHAT MEDIA - chats/{chatId}/media/{userId}/{filename}
    // ========================================================
    match /chats/{chatId}/media/{userId}/{allPaths=**} {
      // Authenticated users can upload to chats they're in
      allow write: if isAuthenticated() && 
                      isOwner(userId) && 
                      fileSizeLimit(50 * 1024 * 1024); // 50MB limit
      
      // Participants can read
      allow read: if isAuthenticated();
      
      // User can delete own uploads
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ========================================================
    // VOICE MESSAGES - messages/{userId}/voice/{filename}
    // ========================================================
    match /voice/{userId}/{allPaths=**} {
      // User can upload own voice messages
      allow write: if isAuthenticated() && 
                      isOwner(userId) && 
                      isAudioFile() && 
                      fileSizeLimit(25 * 1024 * 1024); // 25MB limit
      
      // Authenticated users can read
      allow read: if isAuthenticated();
      
      // User can delete own recordings
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ========================================================
    // VIDEO MESSAGES - videos/{userId}/messages/{filename}
    // ========================================================
    match /videos/{userId}/{allPaths=**} {
      // User can upload own video messages
      allow write: if isAuthenticated() && 
                      isOwner(userId) && 
                      isVideoFile() && 
                      fileSizeLimit(100 * 1024 * 1024); // 100MB limit
      
      // Authenticated users can read
      allow read: if isAuthenticated();
      
      // User can delete own videos
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ========================================================
    // CALL RECORDINGS - recordings/{callId}/{filename}
    // ========================================================
    match /recordings/{callId}/{allPaths=**} {
      // Cloud Function writes recordings
      allow write: if false; // Cloud Function only
      
      // Call participants can read their recordings
      allow read: if isAuthenticated();
      
      // Participants can delete recordings
      allow delete: if false; // Cloud Function only
    }
    
    // ========================================================
    // TEMPORARY FILES - temp/{userId}/{filename}
    // ========================================================
    match /temp/{userId}/{allPaths=**} {
      // User can upload temp files
      allow write: if isAuthenticated() && 
                      isOwner(userId) && 
                      fileSizeLimit(100 * 1024 * 1024);
      
      // User can read own temp files
      allow read: if isAuthenticated() && isOwner(userId);
      
      // User can delete own temp files
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ========================================================
    // DEFAULT DENY
    // ========================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}