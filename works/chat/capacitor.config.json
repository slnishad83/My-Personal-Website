{
  "appId": "com.nishad.myteamchat",
  "appName": "NSL Chat",
  "webDir": "dist",
  "androidScheme": "https",
  "server": {
    "cleartext": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DEFAULT",
      "backgroundColor": "#00000000",
      "overlaysWebView": true,
      "androidOverlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "DEFAULT",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "BackgroundMode": {
      "title": "NSL Chat",
      "text": "Music playback active",
      "subtitle": "NSL Chat is playing music",
      "icon": "ic_launcher",
      "color": "1A1B2E",
      "resume": true,
      "silent": false,
      "hidden": false,
      "keep awake": true
    },
    "Contacts": {
      "permissions": ["readContacts"]
    }
  },
  "android": {
    "allowMixedContent": false,
    "useLegacyBridge": false
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#11131c",
    "preferredContentMode": "mobile",
    "scheme": "app"
  }
}
