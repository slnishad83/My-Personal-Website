{
	"android": {
		"allowMixedContent": false,
		"useLegacyBridge": false
	},
	"androidScheme": "https",
	"appId": "com.nishad.myteamchat",
	"appName": "NSL Chat",
	"ios": {
		"contentInset": "always",
		"backgroundColor": "#11131c",
		"preferredContentMode": "mobile",
		"scheme": "app"
	},
	"plugins": {
		"StatusBar": {
			"style": "DEFAULT",
			"backgroundColor": "#00000000",
			"overlaysWebView": true,
			"androidOverlaysWebView": true
		},
		"Keyboard": {
			"resize": "body",
			"style": "DEFAULT",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"BackgroundMode": {
			"title": "NSL Chat",
			"text": "Music playback active",
			"subtitle": "NSL Chat is playing music",
			"icon": "ic_launcher",
			"color": "1A1B2E",
			"resume": true,
			"silent": false,
			"hidden": false,
			"keep awake": false
		},
		"Contacts": {
			"permissions": [
				"readContacts"
			]
		},
		"Biometric": {
			"allowDeviceCredential": true,
			"iOSBiometry": "FaceID"
		}
	},
	"server": {
		"cleartext": false
	},
	"webDir": "dist",
	"packageClassList": [
		"BackgroundModePlugin",
		"ContactsPlugin",
		"AppPlugin",
		"KeyboardPlugin",
		"PushNotificationsPlugin",
		"StatusBarPlugin"
	]
}
