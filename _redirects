/works/chat/manifest.json /works/chat/dist/manifest.json 200
/works/chat/version.json /works/chat/dist/version.json 200
/works/chat/nsl-logo.png /works/chat/dist/nsl-logo.png 200
/works/chat/app-icon-192.png /works/chat/dist/app-icon-192.png 200
/works/chat/app-icon-512.png /works/chat/dist/app-icon-512.png 200
/works/chat/app-icon.svg /works/chat/dist/app-icon.svg 200
/works/chat/my-team-chat.apk /works/chat/dist/my-team-chat.apk 200

# Catch-all fallback for anything else under /works/chat/
