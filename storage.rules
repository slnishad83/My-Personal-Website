rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }
    function isDocument() {
      return request.resource.contentType.matches('text/.*')
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/json')
        || request.resource.contentType.matches('application/.*word.*')
        || request.resource.contentType.matches('application/.*sheet.*')
        || request.resource.contentType.matches('application/.*presentation.*')
        || request.resource.contentType.matches('application/.*zip.*')
        || request.resource.contentType.matches('application/.*csv.*');
    }
    function isAllowedType() {
      return isImage() || isVideo() || isAudio() || isDocument();
    }

    match /chat_uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024
        && isAllowedType();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /large_uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 500 * 1024 * 1024
        && isAllowedType();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /stories/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024
        && isAllowedType();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /call_recordings/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 200 * 1024 * 1024
        && isAudio();
    }
    match /backups/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /voice_notes/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && isAudio();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /chat_audio/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024 && isAudio();
      allow delete: if request.auth != null;
    }
    match /music/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024 && isAudio();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /status_images/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024 && isImage();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /status_videos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024 && isVideo();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /group_photos/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024 && isImage();
      allow delete: if request.auth != null;
    }
    match /playlist-covers/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024 && isImage();
      allow delete: if request.auth != null;
    }

    // Default deny — no unlisted paths allowed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
