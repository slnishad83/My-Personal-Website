rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /conversations/{conversationId}/{allPaths=**} {
      // Only authenticated users who are part of the conversation can read/write
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // 20 MB max
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('application/.*') ||
          request.resource.contentType.matches('text/.*') ||
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('video/.*')
        );
    }
  }
}
