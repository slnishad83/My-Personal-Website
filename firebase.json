{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "codebase": "default",
      "source": "functions",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/works/chat",
        "type": 301,
        "destination": "/works/chat/dist/"
      },
      {
        "source": "/works/chat/",
        "type": 301,
        "destination": "/works/chat/dist/"
      },
      {
        "source": "/works/chat/index.html",
        "type": 301,
        "destination": "/works/chat/dist/index.html"
      },
      {
        "source": "/works/chat/login.html",
        "type": 301,
        "destination": "/works/chat/dist/login.html"
      },
      {
        "source": "/works/chat/reset.html",
        "type": 301,
        "destination": "/works/chat/dist/reset.html"
      },
      {
        "source": "/works/chat/verify.html",
        "type": 301,
        "destination": "/works/chat/dist/verify.html"
      },
      {
        "source": "/works/chat/turn.html",
        "type": 301,
        "destination": "/works/chat/dist/turn.html"
      },
      {
        "source": "/works/chat/album.html",
        "type": 301,
        "destination": "/works/chat/dist/album.html"
      },
      {
        "source": "/works/chat/calendar.html",
        "type": 301,
        "destination": "/works/chat/dist/calendar.html"
      },
      {
        "source": "/works/chat/expenses.html",
        "type": 301,
        "destination": "/works/chat/dist/expenses.html"
      },
      {
        "source": "/works/chat/insights.html",
        "type": 301,
        "destination": "/works/chat/dist/insights.html"
      }
    ],
    "rewrites": [
      {
        "source": "/works/chat/dist",
        "destination": "/works/chat/dist/index.html"
      },
      {
        "source": "**/reset",
        "destination": "/reset.html"
      }
    ],
    "headers": [
      {
        "source": "/works/chat",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/chat/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/chat/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/app-extras.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/chat-theme.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/style.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/pwa-install.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/chat/chat-2026.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/resume/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/contact/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/chat/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/invoice/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/admin",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/reset.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Clear-Site-Data",
            "value": "\"cache\", \"cookies\", \"storage\", \"executionContexts\""
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          }
        ]
      },
      {
        "source": "**/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"my-team-chat.apk\""
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "works/chat/android/**",
      "works/chat/node_modules/**",
      "works/chat/*.js",
      "works/chat/*.css",
      "works/chat/*.html",
      "works/chat/package.json",
      "works/chat/package-lock.json",
      "works/chat/eslint.config.js",
      "works/chat/capacitor.config.json",
      "works/chat/my-team-chat.apk",
      ".github/**",
      "*.bat",
      "firestore.indexes.json",
      "firestore.rules",
      "storage.rules",
      "README.md"
    ]
  }
}