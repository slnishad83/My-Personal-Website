{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "codebase": "default",
      "source": "functions",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [],
    "rewrites": [
      {
        "source": "/works/chat",
        "destination": "/works/chat/dist/index.html"
      },
      {
        "source": "/works/chat/",
        "destination": "/works/chat/dist/index.html"
      },
      {
        "source": "**/reset",
        "destination": "/reset.html"
      },
      {
        "source": "/works/chat/assets/**",
        "destination": "/works/chat/dist/assets/**"
      },
      {
        "source": "/works/chat/sounds/**",
        "destination": "/works/chat/dist/sounds/**"
      },
      {
        "source": "/works/chat/dist/**",
        "destination": "/works/chat/dist/**"
      },
      {
        "source": "/works/chat/*.js",
        "destination": "/works/chat/dist/*.js"
      },
      {
        "source": "/works/chat/*.json",
        "destination": "/works/chat/dist/*.json"
      },
      {
        "source": "/works/chat/*.css",
        "destination": "/works/chat/dist/*.css"
      },
      {
        "source": "/works/chat/*.png",
        "destination": "/works/chat/dist/*.png"
      },
      {
        "source": "/works/chat/*.svg",
        "destination": "/works/chat/dist/*.svg"
      },
      {
        "source": "/works/chat/*.apk",
        "destination": "/works/chat/dist/*.apk"
      },
      {
        "source": "/works/chat/**",
        "destination": "/works/chat/dist/index.html"
      }
    ],
    "headers": [
      {
        "source": "/works/chat",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/chat/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/chat/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/app-extras.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/chat-theme.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/style.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/works/chat/pwa-install.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/chat/chat-2026.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/resume/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/contact/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/chat/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/invoice/reset",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/admin",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/works/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/reset.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Clear-Site-Data",
            "value": "\"cache\", \"cookies\", \"storage\", \"executionContexts\""
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-XSS-Protection",
            "value": "0"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https://www.gstatic.com https://www.googleapis.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://*.firebaseio.com https://*.cloudfunctions.net https://firebasestorage.googleapis.com https://www.googleapis.com wss://*.firebaseio.com https://chat.nishadsl.com https://nishadsl.com; frame-src 'self' https://*.google.com https://*.youtube.com; worker-src 'self' blob:; base-uri 'self'; object-src 'self'; frame-ancestors 'self'; form-action 'self';"
          }
        ]
      },
      {
        "source": "**/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"my-team-chat.apk\""
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "works/chat/android/**",
      "works/chat/node_modules/**",
      "works/chat/package.json",
      "works/chat/package-lock.json",
      "works/chat/eslint.config.js",
      "works/chat/capacitor.config.json",
      "works/chat/my-team-chat.apk",
      "works/chat/*.html",
      "works/chat/*.js",
      "!works/chat/sw.js",
      "works/chat/*.css",
      "works/chat/src/**",
      "works/chat/tests/**",
      "works/chat/electron/**",
      "works/chat/dist-electron/**",
      "works/chat/ios/**",
      "works/chat/scripts/**",
      ".github/**",
      "*.bat",
      "firestore.indexes.json",
      "firestore.rules",
      "storage.rules",
      "README.md"
    ]
  }
}